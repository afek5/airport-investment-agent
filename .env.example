# Copy to .env (gitignored). scripts/setup-wizard.sh fills these in.

# Anthropic (server-side only). Set a hard monthly spend limit in the console.
ANTHROPIC_API_KEY=
MODEL_ID=anthropic:claude-sonnet-5-5

# Access gate and session cookie signing
ACCESS_CODE=
SESSION_SECRET=

# Spend and abuse guards (SPEC §9)
DAILY_BUDGET_USD=5
RATE_LIMIT_PER_HOUR=30
# Optional lifetime cap across every day and session; blank = none. The Render Blueprint sets 2.
TOTAL_BUDGET_USD=

# Postgres. docker compose sets DATABASE_URL for the app itself; on Render it comes from the Blueprint's database.
DATABASE_URL=
