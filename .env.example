# Copy to .env (gitignored). scripts/setup-wizard.sh fills these in.

# Anthropic (server-side only). Set a hard monthly spend limit in the console.
ANTHROPIC_API_KEY=
MODEL_ID=anthropic:claude-sonnet-5-5

# Access gate and session cookie signing
ACCESS_CODE=
SESSION_SECRET=

# Spend and abuse guards (SPEC §9)
DAILY_BUDGET_USD=5
RATE_LIMIT_PER_HOUR=30

# Postgres. docker compose sets DATABASE_URL for the app itself; Neon is used in production.
DATABASE_URL=
NEON_DATABASE_URL=

# Voice call (stretch, SPEC §10)
OPENAI_API_KEY=

# Public deploy URL (after the Render deploy)
RENDER_URL=
